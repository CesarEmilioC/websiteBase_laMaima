# =============================================================================
# Variables de entorno — La Maima (website)
# =============================================================================
# Copia este archivo a ".env.local" y reemplaza los valores.
# ".env.local" NUNCA se sube al repositorio (ver .gitignore -> patrón ".env*").
#
# Dónde obtener las claves de Supabase:
#   Supabase Dashboard -> proyecto "La Maima" -> Project Settings -> API
# =============================================================================

# URL del proyecto Supabase.
# Ubicación: Project Settings -> API -> "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública "anon" (segura para exponer en el cliente/navegador).
# Ubicación: Project Settings -> API -> "Project API keys" -> "anon public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=REEMPLAZAR

# Clave "service_role": acceso total, se salta Row Level Security (RLS).
# Ubicación: Project Settings -> API -> "Project API keys" -> "service_role"
# SOLO se usa en el servidor (route handlers, server actions, cron jobs).
# NUNCA debe llevar el prefijo NEXT_PUBLIC_ ni exponerse al cliente.
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR

# -----------------------------------------------------------------------------
# Futuras integraciones (se agregarán en fases posteriores del roadmap)
# -----------------------------------------------------------------------------

# Pasarela de pagos Wompi (Bancolombia) -> https://comercios.wompi.co
# WOMPI_PUBLIC_KEY=
# WOMPI_PRIVATE_KEY=
# WOMPI_EVENTS_SECRET=

# Envío de emails transaccionales (confirmaciones de reserva) -> https://resend.com
# RESEND_API_KEY=
