# =============================================================================
# Variables de entorno — La Maima (website)
# =============================================================================
# Copia este archivo a ".env.local" y reemplaza los valores.
# ".env.local" NUNCA se sube al repositorio (ver .gitignore -> patrón ".env*").
#
# Dónde obtener las claves de Supabase:
#   Supabase Dashboard -> proyecto "La Maima" -> Project Settings -> API
# =============================================================================

# URL del proyecto Supabase.
# Ubicación: Project Settings -> API -> "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública "anon" (segura para exponer en el cliente/navegador).
# Ubicación: Project Settings -> API -> "Project API keys" -> "anon public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=REEMPLAZAR

# Clave "service_role": acceso total, se salta Row Level Security (RLS).
# Ubicación: Project Settings -> API -> "Project API keys" -> "service_role"
# SOLO se usa en el servidor (route handlers, server actions, cron jobs).
# NUNCA debe llevar el prefijo NEXT_PUBLIC_ ni exponerse al cliente.
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR

# -----------------------------------------------------------------------------
# Futuras integraciones (se agregarán en fases posteriores del roadmap)
# -----------------------------------------------------------------------------

# Pasarela de pagos Wompi (Bancolombia) -> https://comercios.wompi.co
# WOMPI_PUBLIC_KEY=
# WOMPI_PRIVATE_KEY=
# WOMPI_EVENTS_SECRET=

# -----------------------------------------------------------------------------
# Emails transaccionales — Resend (https://resend.com)
# -----------------------------------------------------------------------------
# Las plantillas y el envío ya están implementados en src/lib/email/, pero
# quedan DORMIDOS: si RESEND_API_KEY no está definida, sendBookingConfirmation()
# y sendBookingNotification() registran en consola qué habrían enviado y
# devuelven sin error (nunca lanzan, porque se llaman desde el webhook de pago).
#
# Para activarlos:
#   1. Crear la cuenta de Resend y verificar el dominio lamaima.com (DNS).
#   2. Descomentar las tres variables y completarlas.
#   3. Cargarlas también en Vercel (Project Settings -> Environment Variables).
#
# Clave de API: Resend -> API Keys -> "Create API Key" (permiso "Sending access").
# RESEND_API_KEY=

# Remitente. DEBE pertenecer al dominio verificado en Resend; si no, el correo
# se marca como spam. Por defecto: "La Maima <reservas@lamaima.com>".
# EMAIL_FROM=La Maima <reservas@lamaima.com>

# Destinatario del aviso interno de nueva reserva (el correo del hotel).
# Admite varios separados por coma. Sin esta variable el aviso no se envía.
# EMAIL_NOTIFY_TO=reservas@lamaima.com
